# Copy to .env and replace ALL values. Do not commit .env.
DOMAIN=share.example.com
TURN_HOST=turn.example.com
# Server public IPv4; replace with your actual IP.
PUBLIC_IP=203.0.113.10
# Generate separately with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
TURN_SECRET=REPLACE_WITH_RANDOM_64_HEX_CHARACTERS
ENROLLMENT_KEY=REPLACE_WITH_32_BYTES_BASE64URL_KEY
